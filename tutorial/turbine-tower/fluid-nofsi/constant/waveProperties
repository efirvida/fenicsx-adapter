FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      waveProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

inlet
{
    alpha            alpha.water;
    waveModel        StokesV;
    nPaddle          5;
    waveHeight       1;
    waveAngle        0.0;
    rampTime         1.0;
    activeAbsorption yes;
    wavePeriod       2;
}

outlet
{
    alpha           alpha.water;

    waveModel       shallowWaterAbsorption;

    nPaddle         1;
}


