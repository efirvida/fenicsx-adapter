FoamFile
{
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


xmin  -5;
xmax   15;

ymin  -5;
ymax   5;

zmin   0;
zmax  10;


vertices
(
    ($xmax $ymax $zmin )         // 0
    ($xmin $ymax $zmin )         // 1
    ($xmin $ymin $zmin )         // 2
    ($xmax $ymin $zmin )         // 3
    ($xmax $ymax $zmax )         // 4
    ($xmin $ymax $zmax )         // 5
    ($xmin $ymin $zmax )         // 6
    ($xmax $ymin $zmax )         // 7
);

blocks
(
    hex (   0   1   2   3   4  5  6  7  )
    (60 30 30)
    simpleGrading (1 1 1)
);

