boundary
(

    inlet
    {
        type patch;
        faces
        (
            (1 2 5 6)
        );
    }    
    outlet
    {
        type patch;
        faces
        (
            (3 0 4 7)
        );
    }    
    floor
    {
        type symmetryPlane;
        faces
        (
            (0 1 2 3)
        );
    }
    externalDomain_1
    {
        type symmetryPlane;
        faces
        (
            (0 1 4 5)
        );
    }
    externalDomain_2
    {
        type symmetryPlane;
        faces
        (
            (2 3 6 7)
        );
    }
    externalDomain_3
    {
        type symmetryPlane;
        faces
        (
            (4 5 6 7)
        );
    }    

);
